# .scriptlint - Repository commit message rules
# This is a lightweight, repo-controlled lint configuration meant to be
# extended over time. It's intentionally simple and human-readable so
# maintainers can update it as needed.

format: |
  Require commit subject in the form: <component>: <short description>
  - component: file or module name (alphanum, underscore, dash, slash, dot)
  - short description: 1..72 characters

rules:
  # Regular expression the commit SUBJECT must match
  subject_regex: "^[A-Za-z0-9_\/.\-]+: .{1,72}$"

  # Maximum length for the subject line (characters)
  subject_max_length: 72

  # If the commit has a body, require a blank line after the subject
  body_require_blank_line_after_subject: true

  # Soft wrap width for body lines; useful for reviewers and changelogs
  body_line_length: 72

# Examples contributors can follow
examples:
  good:
    - "py-scripts/lf_wifi_capacity_test.py: Add support to load existing test config"
    - "ci: Run flake8 only on push to reduce duplicate PR runs"
  bad:
    - "fixup: something"
    - "typo"

# Notes:
# - This file is not a lint engine by itself. Use gitlint/gitlint rules or a
#   pre-commit hook that reads this file to enforce rules locally/CI.
# - To start, the pr-review workflow will run gitlint and other linters; they
#   can be configured to read this file or a mapping can be added to the CI.
