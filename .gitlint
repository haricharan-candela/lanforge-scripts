[general]
ignore-merge-commits = True
# A body is optional per SCRIPTS_RULES.md ("If a body is present, leave a
# blank line..."); don't flag single-line subject-only commits.
ignore = body-is-missing

[title-max-length]
line-length = 72

[title-match-regex]
regex = ^[A-Za-z0-9_\/\.\-]+: .+$

# Notes:
# - This file defines rules for gitlint to enforce commit message style.
# - Section names must be gitlint's built-in rule names (see
#   https://jorisroovers.com/gitlint/latest/rules/builtin_rules/).
#   gitlint has no mechanism for inline custom rules in this file; the
#   previous [rule "..."] sections here were not valid syntax and made
#   every run fail with a config error instead of linting the commit.
# - To test locally: pip install gitlint
#   and run: gitlint --config .gitlint --commits <base>..HEAD
